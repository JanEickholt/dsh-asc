{
  "name": "@dsh-asc/compaction-agentic",
  "description": "Agentic Surface Compaction backend for DeepSeek Harness: the model decides when and what to compact, committed as durable session-log replacements with full replay, search, and degradation",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-asc/compaction-agentic.git"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./events": {
      "types": "./lib/types/events.d.ts",
      "default": "./lib/types/events.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-compaction": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session-query": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session-query": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"const fs=require('fs');for(const d of ['lib','dist'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
